<?xml version="1.0" encoding="utf-8"?>
<!-- Create Meal screen layout - form to add a new meal -->
<!-- Includes: meal name, category dropdown, ingredients, cost, and calories -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ===== HEADER WITH BACK BUTTON ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <!-- Back arrow - closes the screen -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/back_arrow"
                android:textColor="#26312D"
                android:textSize="32sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Screen title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/create_meal_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#08752F"
                android:gravity="center" />

        </LinearLayout>

        <!-- Subtitle line 1 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_meal_subtitle"
            android:textColor="#78817F"
            android:textSize="13sp"
            android:layout_marginBottom="4dp" />

        <!-- Subtitle line 2 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_meal_subtitle2"
            android:textColor="#78817F"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <!-- ===== MEAL NAME INPUT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_meal_name_label"
            android:textColor="#26312D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <!-- Outlined text field for meal name -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#19B957"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMealName"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/create_meal_name_hint"
                android:textSize="13sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== CATEGORY DROPDOWN ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_meal_category_label"
            android:textColor="#26312D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <!-- Spinner for meal category (Breakfast/Lunch/Dinner/Snack) -->
        <Spinner
            android:id="@+id/spinnerCategory"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@android:drawable/btn_dropdown"
            android:layout_marginBottom="16dp" />

        <!-- ===== INGREDIENTS INPUT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_meal_ingredients_label"
            android:textColor="#26312D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <!-- Multi-line text area for ingredients -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#19B957"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/create_meal_ingredients_hint"
                android:textSize="13sp"
                android:inputType="textMultiLine"
                android:minLines="3" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== COST INPUT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_meal_cost_label"
            android:textColor="#26312D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <!-- Cost input field (accepts decimal numbers) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#19B957"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCost"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/create_meal_cost_hint"
                android:textSize="13sp"
                android:inputType="numberDecimal" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- ===== CALORIES INPUT ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_meal_cal_label"
            android:textColor="#26312D"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="7dp" />

        <!-- Calories input field (accepts whole numbers) -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:boxStrokeColor="#19B957"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etCalories"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="@string/create_meal_cal_hint"
                android:textSize="13sp"
                android:inputType="number" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tip text at the bottom -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/create_meal_tip"
            android:textColor="#78817F"
            android:textSize="11sp"
            android:layout_marginBottom="16dp" />

        <!-- ===== SAVE BUTTON ===== -->
        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/create_meal_save"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#19B957" />

    </LinearLayout>

</ScrollView>