<?xml version="1.0" encoding="utf-8"?>
<!-- Weekly Plan screen layout - shows the 5-day meal grid -->
<!-- Contains: week selector, meal grid (breakfast/lunch/dinner rows), summary, add button -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ===== HEADER WITH BACK BUTTON ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <!-- Back arrow -->
            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/back_arrow"
                android:textColor="#26312D"
                android:textSize="32sp"
                android:clickable="true"
                android:focusable="true" />

            <!-- Screen title -->
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/weekly_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#08752F"
                android:gravity="center" />

        </LinearLayout>

        <!-- ===== WEEK SELECTOR (with arrows) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:layout_marginTop="8dp"
            android:elevation="2dp">

            <!-- Left arrow (previous week - not implemented) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="←"
                android:textSize="24sp"
                android:textColor="#19B957"
                android:padding="8dp" />

            <!-- Week label - updated dynamically (e.g. "Week 39 — September") -->
            <TextView
                android:id="@+id/tvWeekLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/weekly_week"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center" />

            <!-- Right arrow (next week - not implemented) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textSize="24sp"
                android:textColor="#19B957"
                android:padding="8dp" />

        </LinearLayout>

        <!-- ===== DATE RANGE (Mon - Fri) - updated dynamically ===== -->
        <TextView
            android:id="@+id/tvWeekDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/weekly_dates"
            android:textColor="#78817F"
            android:textSize="12sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- ===== MEAL GRID ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:elevation="2dp">

            <!-- ===== GRID HEADER ROW (day names) ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E8F5E9"
                android:padding="8dp">

                <!-- Empty corner cell -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text=" "
                    android:textStyle="bold" />

                <!-- Day headers -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="MON 4"
                    android:textColor="#08752F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TUE 5"
                    android:textColor="#08752F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="WED 6"
                    android:textColor="#08752F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="THU 7"
                    android:textColor="#08752F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FRI 8"
                    android:textColor="#08752F"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />

            </LinearLayout>

            <!-- ===== BREAKFAST ROW ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FAFAFA">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="Breakfast"
                    android:textColor="#333333"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Monday - Avocado Toast -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Avocado Toast"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:gravity="center" />

                <!-- Tuesday - Greek Yogurt -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Greek Yogurt"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:gravity="center" />

                <!-- Wednesday - "+" button (clickable) -->
                <TextView
                    android:id="@+id/btnWedBreakfast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+"
                    android:textColor="#19B957"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Thursday - Oat Porridge -->
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Oat Porridge"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:gravity="center" />

                <!-- Friday - "+" button -->
                <TextView
                    android:id="@+id/btnFriBreakfast"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+"
                    android:textColor="#19B957"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- ===== LUNCH ROW ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="Lunch"
                    android:textColor="#333333"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMonLunch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+"
                    android:textColor="#19B957"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chicken Wrap"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btnWedLunch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+"
                    android:textColor="#19B957"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tomato Soup"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tuna Poke"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:gravity="center" />

            </LinearLayout>

            <!-- ===== DINNER ROW ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="#FAFAFA">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text="Dinner"
                    android:textColor="#333333"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnMonDinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+"
                    android:textColor="#19B957"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grilled Salmon"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btnWedDinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+"
                    android:textColor="#19B957"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Chicken Stir-fry"
                    android:textColor="#333333"
                    android:textSize="10sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/btnFriDinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="+"
                    android:textColor="#19B957"
                    android:textSize="16sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== SUMMARY SECTION (total, meals planned, per day) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <!-- Total cost column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekly_total_cost"
                    android:textSize="12sp"
                    android:textColor="#78817F" />

                <!-- Total cost value - updated in code -->
                <TextView
                    android:id="@+id/tvTotalCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R 0.00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#19B957" />

            </LinearLayout>

            <!-- Meals planned column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekly_meals_planned"
                    android:textSize="12sp"
                    android:textColor="#78817F" />

                <!-- Meals count - updated in code -->
                <TextView
                    android:id="@+id/tvMealsPlanned"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/15"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#19B957" />

            </LinearLayout>

            <!-- Per day average column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/weekly_per_day"
                    android:textSize="12sp"
                    android:textColor="#78817F" />

                <!-- Per day value - updated in code -->
                <TextView
                    android:id="@+id/tvPerDayAvg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="R 0.00"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#19B957" />

            </LinearLayout>

        </LinearLayout>

        <!-- ===== ADD MEAL BUTTON ===== -->
        <Button
            android:id="@+id/btnAddMeal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="16dp"
            android:text="@string/weekly_add_meal"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#19B957" />

        <!-- ===== HINT TEXT AT BOTTOM ===== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/weekly_hint"
            android:textColor="#78817F"
            android:textSize="10sp"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>