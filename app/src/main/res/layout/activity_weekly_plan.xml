<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="@string/back_arrow"
                android:textColor="#26312D"
                android:textSize="32sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/weekly_title"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#08752F"
                android:gravity="center" />
        </LinearLayout>

        <!-- Week Selector -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:layout_marginTop="8dp"
            android:elevation="2dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/weekly_back"
                android:textSize="24sp"
                android:textColor="#19B957"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvWeekLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/weekly_week"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="→"
                android:textSize="24sp"
                android:textColor="#19B957"
                android:padding="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvWeekDates"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dates"
            android:textColor="#78817F"
            android:textSize="12sp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Meal Grid Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="8dp"
            android:layout_marginHorizontal="8dp"
            android:elevation="2dp">

            <!-- Header Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#E8F5E9"
                android:padding="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:text=" "
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvHeaderMon"
                    style="@style/MealHeader" />

                <TextView
                    android:id="@+id/tvHeaderTue"
                    style="@style/MealHeader" />

                <TextView
                    android:id="@+id/tvHeaderWed"
                    style="@style/MealHeader" />

                <TextView
                    android:id="@+id/tvHeaderThu"
                    style="@style/MealHeader" />

                <TextView
                    android:id="@+id/tvHeaderFri"
                    style="@style/MealHeader" />
            </LinearLayout>

            <!-- Breakfast Row -->
            <LinearLayout
                style="@style/MealRow"
                android:background="#FAFAFA">

                <TextView
                    style="@style/MealRowLabel"
                    android:text="@string/weekly_breakfast" />

                <TextView android:id="@+id/tvMonBreakfast" style="@style/MealCell" />
                <TextView android:id="@+id/tvTueBreakfast" style="@style/MealCell" />
                <TextView android:id="@+id/tvWedBreakfast" style="@style/MealCell" />
                <TextView android:id="@+id/tvThuBreakfast" style="@style/MealCell" />
                <TextView android:id="@+id/tvFriBreakfast" style="@style/MealCell" />
            </LinearLayout>

            <!-- Lunch Row -->
            <LinearLayout
                style="@style/MealRow"
                android:background="#FFFFFF">

                <TextView
                    style="@style/MealRowLabel"
                    android:text="@string/weekly_lunch" />

                <TextView android:id="@+id/tvMonLunch" style="@style/MealCell" />
                <TextView android:id="@+id/tvTueLunch" style="@style/MealCell" />
                <TextView android:id="@+id/tvWedLunch" style="@style/MealCell" />
                <TextView android:id="@+id/tvThuLunch" style="@style/MealCell" />
                <TextView android:id="@+id/tvFriLunch" style="@style/MealCell" />
            </LinearLayout>

            <!-- Dinner Row -->
            <LinearLayout
                style="@style/MealRow"
                android:background="#FAFAFA">

                <TextView
                    style="@style/MealRowLabel"
                    android:text="@string/weekly_dinner" />

                <TextView android:id="@+id/tvMonDinner" style="@style/MealCell" />
                <TextView android:id="@+id/tvTueDinner" style="@style/MealCell" />
                <TextView android:id="@+id/tvWedDinner" style="@style/MealCell" />
                <TextView android:id="@+id/tvThuDinner" style="@style/MealCell" />
                <TextView android:id="@+id/tvFriDinner" style="@style/MealCell" />
            </LinearLayout>

        </LinearLayout>

        <!-- Summary Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="8dp"
            android:background="#FFFFFF"
            android:elevation="2dp">

            <LinearLayout style="@style/SummaryBlock">
                <TextView
                    style="@style/SummaryLabel"
                    android:text="@string/weekly_total_cost" />

                <TextView
                    android:id="@+id/tvTotalCost"
                    style="@style/SummaryValue" />
            </LinearLayout>

            <LinearLayout style="@style/SummaryBlock" android:gravity="center">
                <TextView
                    style="@style/SummaryLabel"
                    android:text="@string/weekly_meals_planned" />

                <TextView
                    android:id="@+id/tvMealsPlanned"
                    style="@style/SummaryValue" />
            </LinearLayout>

            <LinearLayout style="@style/SummaryBlock" android:gravity="end">
                <TextView
                    style="@style/SummaryLabel"
                    android:text="@string/weekly_per_day" />

                <TextView
                    android:id="@+id/tvPerDayAvg"
                    style="@style/SummaryValue" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnAddMeal"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_margin="16dp"
            android:text="@string/weekly_add_meal"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#19B957" />

    </LinearLayout>
</ScrollView>